<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Card surface used for toolbar, panels and KPI tiles. -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource CardBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="14" />
  </Style>

  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
    <Setter Property="Margin" Value="2,0,0,4" />
  </Style>

  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>

  <Style Selector="TextBlock.kpi">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
  </Style>

  <!-- Primary start/stop button. -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource BrandGradient}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="18,8" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrandGradient}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Opacity" Value="0.9" />
  </Style>
  <Style Selector="Button.primary.danger">
    <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
  </Style>
  <Style Selector="Button.primary.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
  </Style>

  <Style Selector="Button.tool, ToggleButton.tool">
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>

  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="TextBox, ComboBox">
    <Setter Property="CornerRadius" Value="8" />
  </Style>

  <!-- Protocol pill in the packet list. -->
  <Style Selector="Border.pill">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="8,1" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.pill > TextBlock">
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <!-- Info / error banners. -->
  <Style Selector="Border.banner">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.banner.info">
    <Setter Property="Background" Value="#1A4F46E5" />
    <Setter Property="BorderBrush" Value="#664F46E5" />
  </Style>
  <Style Selector="Border.banner.error">
    <Setter Property="Background" Value="#1AE11D48" />
    <Setter Property="BorderBrush" Value="#66E11D48" />
  </Style>

  <!-- Setup assistant -->
  <Style Selector="Border.card.setup">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Padding" Value="18,14" />
  </Style>
  <Style Selector="Border.step">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="CornerRadius" Value="15" />
    <Setter Property="Margin" Value="0,0,14,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource SubtleFill}" />
  </Style>
  <Style Selector="Border.step TextBlock">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="Border.step.ok">
    <Setter Property="Background" Value="{DynamicResource UdpBrush}" />
  </Style>
  <Style Selector="Border.step.warn">
    <Setter Property="Background" Value="{DynamicResource WarnBrush}" />
  </Style>
  <Style Selector="Border.step.ok TextBlock, Border.step.warn TextBlock">
    <Setter Property="Foreground" Value="White" />
  </Style>

  <!-- Follow stream: client (A) teal, server (B) indigo, like Wireshark's red/blue. -->
  <Style Selector="Border.dirA">
    <Setter Property="Background" Value="{DynamicResource UdpBrush}" />
  </Style>
  <Style Selector="Border.dirB">
    <Setter Property="Background" Value="{DynamicResource TcpBrush}" />
  </Style>
  <Style Selector="Border.chunk">
    <Setter Property="BorderThickness" Value="3,0,0,0" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="Border.chunk.a">
    <Setter Property="BorderBrush" Value="{DynamicResource UdpBrush}" />
    <Setter Property="Background" Value="#1414B8A6" />
  </Style>
  <Style Selector="Border.chunk.b">
    <Setter Property="BorderBrush" Value="{DynamicResource TcpBrush}" />
    <Setter Property="Background" Value="#146366F1" />
    <Setter Property="Margin" Value="40,0,0,10" />
  </Style>

  <!-- Conversation filter chip above the packet list. -->
  <Style Selector="Border.chip">
    <Setter Property="Background" Value="{DynamicResource SubtleFill}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="12,2,4,2" />
  </Style>

  <Style Selector="TabControl > TabItem">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="MinHeight" Value="40" />
  </Style>

  <Style Selector="TabStrip TabStripItem">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="10,4" />
  </Style>

  <Style Selector="DataGrid">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="GridLinesVisibility" Value="None" />
    <Setter Property="HeadersVisibility" Value="Column" />
    <Setter Property="RowHeight" Value="30" />
  </Style>
  <Style Selector="DataGridCell">
    <Setter Property="FontSize" Value="12.5" />
  </Style>
  <Style Selector="DataGridCell.mono">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
  </Style>

  <Style Selector="GridSplitter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
</Styles>
